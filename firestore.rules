rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /my_anki/{uid}/reviews/{reviewId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['cardId', 'grade', 'reviewedAt', 'clientId', 'createdAt'])
        && request.resource.data.cardId is string
        && request.resource.data.cardId.matches('^[a-f0-9]{16}$')
        && request.resource.data.grade is int
        && request.resource.data.grade >= 0
        && request.resource.data.grade <= 3
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() >= 1
        && request.resource.data.clientId.size() <= 64
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /my_anki/{uid}/meta/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && (docId == 'baseline' || docId.matches('^baseline_.+'))
        && request.resource.data.keys().hasOnly(['state', 'takenAt', 'createdAt'])
        && request.resource.data.state is map
        && request.resource.data.takenAt is timestamp
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /my_anki/{uid}/visibility/{eventId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['id', 'cardId', 'hidden', 'at', 'createdAt'])
        && request.resource.data.id == eventId
        && request.resource.data.cardId is string
        && request.resource.data.cardId.matches('^[a-f0-9]{16}$')
        && request.resource.data.hidden is bool
        && request.resource.data.at is int
        && request.resource.data.at > 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /my_anki/{uid}/imports/{importId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['source', 'collectedAt', 'books', 'createdAt'])
        && request.resource.data.source == 'my-anki-kindle-extension'
        && request.resource.data.collectedAt is timestamp
        && request.resource.data.books is list
        && request.resource.data.books.size() > 0
        && request.resource.data.books.size() <= 10
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
